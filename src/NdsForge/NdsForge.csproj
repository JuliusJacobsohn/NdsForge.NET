<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>NdsForge</PackageId>
    <Title>NdsForge.NET</Title>
    <Description>Production-grade pure C# library for reading, validating, editing, extracting, comparing, and building Nintendo DS and DSi images.</Description>
    <Authors>Julius Jacobsohn;NdsForge.NET contributors</Authors>
    <PackageTags>nintendo-ds;nds;dsi;nitrofs;rom-hacking;cartridge-image</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md for release details, compatibility, and safety guidance.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/JuliusJacobsohn/NdsForge.NET</RepositoryUrl>
    <PackageProjectUrl>https://github.com/JuliusJacobsohn/NdsForge.NET</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;RS0016;RS0017</WarningsAsErrors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Link="LICENSE.txt" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
