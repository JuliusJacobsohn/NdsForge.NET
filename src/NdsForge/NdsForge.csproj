<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>NdsForge</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Description>Pure C# toolkit for inspecting, editing, extracting, and building Nintendo DS and DSi images.</Description>
    <Authors>NdsForge.NET contributors</Authors>
    <PackageTags>nintendo-ds;nds;dsi;nitrofs;rom-hacking</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

