<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>NdsForge.Graphics</PackageId>
    <Title>NdsForge.NET Nitro graphics</Title>
    <Description>Indexed graphics primitives and native Nintendo DS and DSi 2D resource formats.</Description>
    <Authors>Julius Jacobsohn;NdsForge.NET contributors</Authors>
    <PackageTags>nintendo-ds;nds;dsi;nitro;graphics;nclr;ncgr;nscr;ncer;nanr;nftr;font;logo;rom-hacking</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md for release details and compatibility guidance.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/JuliusJacobsohn/NdsForge.NET</RepositoryUrl>
    <PackageProjectUrl>https://github.com/JuliusJacobsohn/NdsForge.NET</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;RS0016;RS0017</WarningsAsErrors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.1.0</PackageValidationBaselineVersion>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <ProjectReference Include="../NdsForge.Nitro/NdsForge.Nitro.csproj" />
    <None Include="../../assets/branding/ndsforge-icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Link="LICENSE.txt" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
