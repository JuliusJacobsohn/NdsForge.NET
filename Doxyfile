DOXYFILE_ENCODING          = UTF-8
PROJECT_NAME               = NdsForge.NET
PROJECT_NUMBER             = $(NDSFORGE_DOC_VERSION)
PROJECT_BRIEF              = "Read, validate, edit, compare, and build Nintendo DS and DSi images from .NET"

OUTPUT_DIRECTORY           = $(NDSFORGE_REPOSITORY_ROOT)/artifacts/docs
HTML_OUTPUT                = html
FULL_PATH_NAMES            = YES
STRIP_FROM_PATH            = $(NDSFORGE_REPOSITORY_ROOT)

EXTENSION_MAPPING          = cs=Csharp
MARKDOWN_SUPPORT           = YES
MARKDOWN_STRICT            = YES
MARKDOWN_ID_STYLE          = GITHUB
AUTOLINK_SUPPORT           = YES
USE_MDFILE_AS_MAINPAGE     = $(NDSFORGE_REPOSITORY_ROOT)/README.md

EXTRACT_ALL                = NO
EXTRACT_PRIVATE            = NO
EXTRACT_PACKAGE            = NO
EXTRACT_STATIC             = YES
HIDE_UNDOC_MEMBERS         = NO
HIDE_UNDOC_CLASSES         = NO
HIDE_UNDOC_NAMESPACES      = NO

WARNINGS                   = YES
WARN_IF_UNDOCUMENTED       = YES
WARN_IF_DOC_ERROR          = YES
WARN_IF_INCOMPLETE_DOC     = YES
WARN_NO_PARAMDOC           = YES
WARN_IF_UNDOC_ENUM_VAL     = YES
WARN_AS_ERROR              = FAIL_ON_WARNINGS_PRINT

INPUT                      = $(NDSFORGE_REPOSITORY_ROOT)/src/NdsForge \
                             $(NDSFORGE_REPOSITORY_ROOT)/README.md \
                             $(NDSFORGE_REPOSITORY_ROOT)/docs/getting-started.md \
                             $(NDSFORGE_REPOSITORY_ROOT)/docs/concepts.md \
                             $(NDSFORGE_REPOSITORY_ROOT)/docs/formats-and-safety.md \
                             $(NDSFORGE_REPOSITORY_ROOT)/docs/cli.md \
                             $(NDSFORGE_REPOSITORY_ROOT)/docs/corpus-testing.md \
                             $(NDSFORGE_REPOSITORY_ROOT)/CONTRIBUTING.md \
                             $(NDSFORGE_REPOSITORY_ROOT)/SECURITY.md \
                             $(NDSFORGE_REPOSITORY_ROOT)/SUPPORT.md \
                             $(NDSFORGE_REPOSITORY_ROOT)/RELEASING.md \
                             $(NDSFORGE_REPOSITORY_ROOT)/CODE_OF_CONDUCT.md \
                             $(NDSFORGE_REPOSITORY_ROOT)/THIRD_PARTY_NOTICES.md
FILE_PATTERNS              = *.cs *.md
RECURSIVE                  = YES
EXCLUDE_PATTERNS           = */bin/* */obj/*

SOURCE_BROWSER             = YES
INLINE_SOURCES             = NO
SHOW_FILES                 = NO
SHOW_NAMESPACES            = YES

GENERATE_HTML              = YES
HTML_COLORSTYLE            = TOGGLE
HTML_EXTRA_STYLESHEET      = $(NDSFORGE_REPOSITORY_ROOT)/assets/ndsforge-doxygen.css
HTML_DYNAMIC_MENUS         = YES
HTML_DYNAMIC_SECTIONS      = YES
GENERATE_TREEVIEW          = YES
FULL_SIDEBAR               = YES
PAGE_OUTLINE_PANEL         = YES
DISABLE_INDEX              = NO
SEARCHENGINE               = YES
SERVER_BASED_SEARCH        = NO
TIMESTAMP                  = NO

GENERATE_LATEX             = NO
GENERATE_RTF               = NO
GENERATE_MAN               = NO
GENERATE_XML               = NO
GENERATE_DOCBOOK           = NO

ENABLE_PREPROCESSING       = YES
MACRO_EXPANSION            = YES
EXPAND_ONLY_PREDEF         = YES
PREDEFINED                 = DOXYGEN record=class
